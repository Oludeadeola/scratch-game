{
  "name": "mathblocks-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node init && next dev --turbopack",
    "build": "node init && next build --turbopack",
    "start": "node init && next start",
    "lint": "eslint",
    "sync": "y-websocket-server",
    "typecheck": "tsc --noEmit",
    "verify": "tsc lib/program.ts lib/runtime.ts lib/challenges.ts --outDir .verify --module commonjs --target es2020 --skipLibCheck --esModuleInterop && node scripts/check-challenges.cjs .verify",
    "verify:sync": "node scripts/check-sync.cjs",
    "verify:all": "npm run typecheck && npm run verify && npm run verify:sync"
  },
  "dependencies": {
    "blockly": "^12.4.1",
    "next": "^15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@y/websocket-server": "^0.1.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
